# Copy to backend/.env for local development. Never commit .env files.
# Every variable is documented in app/config.py and PRD §7.

# --- Local emulator ---------------------------------------------------------
GCP_PROJECT_ID=demo-lastmile
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# --- GenAI ---------------------------------------------------------------------
# fake = scripted outputs, no API key needed. real = Gemini API (free tier).
GENAI_MODE=fake
GENAI_USE_VERTEX=false
LIVE_USE_AI_STUDIO=true
# Put your own key here only when GENAI_MODE=real. Get one from Google AI Studio.
GEMINI_API_KEY=
GEMINI_RPM=10

# --- Demo access ---------------------------------------------------------------
DEMO_PASSCODE=local-dev-passcode
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Simulation ----------------------------------------------------------------
SIM_TIME_SCALE=10
# Short ring timeout so the live residents R-001/R-002 time out quickly in dev (prod: 120).
LIVE_RING_TIMEOUT_S=15
# M2: no coordinator approval UI yet, so let volunteer bots pick tasks up automatically.
AUTO_APPROVE_DISPATCH=true
# M2: deterministic fallback policy only (the LLM decision engine arrives in M3).
FORCE_FALLBACK=true
SIM_DIALOGUE_MODE=cached
LOG_LEVEL=INFO
