# Copy to frontend/.env.local for local development. Never commit .env files.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WS_BASE_URL=ws://127.0.0.1:8000
# Connect to the local Firestore/Auth emulators (make emulators).
VITE_USE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-lastmile
# Firebase web config: public by design, but keep it in .env.production (not committed).
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-lastmile.firebaseapp.com
VITE_FIREBASE_APP_ID=demo-app
